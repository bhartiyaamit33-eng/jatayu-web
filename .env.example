# --- Public site ---
NEXT_PUBLIC_SITE_URL=https://jatayuhealth.com

# Existing app login (header ghost button)
NEXT_PUBLIC_LOGIN_URL=https://app.jatayuhealth.com/login

# Optional hero demo film served from GCS or CDN
# NEXT_PUBLIC_HERO_VIDEO_URL=https://storage.googleapis.com/your-bucket/voicedocai-hero-60s.mp4

# --- Payload CMS ---
# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=dev-secret-change-me-in-prod

# Postgres connection string. Local Docker default below; in production point
# at Azure Database for PostgreSQL Flexible Server (sslmode=require).
DATABASE_URI=postgres://jatayu:jatayu_dev_password@localhost:5432/jatayu_cms

# --- Azure Blob Storage (production only) ---
# When all three are set AND NODE_ENV=production, Payload writes uploaded media
# to Azure Blob Storage instead of local disk. Leave unset for local dev.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_ACCOUNT_BASEURL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_CONTAINER_NAME=media
