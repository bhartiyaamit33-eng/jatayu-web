# --- Public site ---
NEXT_PUBLIC_SITE_URL=https://jatayuhealth.com

# Existing app login (header ghost button)
NEXT_PUBLIC_LOGIN_URL=https://app.jatayuhealth.com/login

# Optional hero demo film served from GCS or CDN
# NEXT_PUBLIC_HERO_VIDEO_URL=https://storage.googleapis.com/your-bucket/voicedocai-hero-60s.mp4

# --- Payload CMS ---
# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=dev-secret-change-me-in-prod

# Postgres connection string. Local Docker default below.
#
# Production (Google Cloud SQL for PostgreSQL), pick one:
#   - Cloud Run via Unix socket (with --add-cloudsql-instances):
#       postgres://USER:PASS@/jatayu_cms?host=/cloudsql/PROJECT:REGION:INSTANCE
#   - Private IP (VPC connector):
#       postgres://USER:PASS@PRIVATE_IP:5432/jatayu_cms?sslmode=require
DATABASE_URI=postgres://jatayu:jatayu_dev_password@localhost:5432/jatayu_cms

# --- Media storage ---
# Storage backend is selected by which vars are set (see payload.config.ts):
#   1. GCS_BUCKET set            -> Google Cloud Storage (target for Cloud Run)
#   2. Azure vars set + prod     -> Azure Blob Storage (legacy/transition)
#   3. nothing set               -> local disk (dev / CI)

# Google Cloud Storage (production on Cloud Run).
# On Cloud Run, credentials come from the service account via ADC — only
# GCS_BUCKET is required there. For local testing against a real bucket, set
# GCS_PROJECT_ID and GCS_KEY_FILENAME (path to a service-account JSON key),
# or run `gcloud auth application-default login`.
# GCS_BUCKET=jatayu-prod-media
# GCS_PROJECT_ID=your-gcp-project-id
# GCS_KEY_FILENAME=./gcp-sa-key.json

# Azure Blob Storage (legacy — only while still running on Azure).
# Set all three AND NODE_ENV=production to write uploads to Azure Blob.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_ACCOUNT_BASEURL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_CONTAINER_NAME=media
