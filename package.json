{
  "name": "jatayu-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "devsafe": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate:types": "payload generate:types",
    "payload": "payload",
    "seed": "curl -sS -X POST -H \"x-seed-secret: $(grep ^PAYLOAD_SECRET .env.local | cut -d= -f2)\" http://localhost:3000/api/seed | node -e 'let d=\"\";process.stdin.on(\"data\",c=>d+=c).on(\"end\",()=>{const j=JSON.parse(d);console.log(j.ok?\"OK \"+j.count+\" ops\":\"FAIL: \"+j.error);(j.log||[]).forEach(l=>console.log(\"  \"+l));process.exit(j.ok?0:1)})'",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "sync-prod-schema": "bash scripts/sync-prod-schema.sh",
    "db:migrate": "bash scripts/migrate-postgres.sh",
    "docs:screenshots": "node scripts/take-shots.mjs",
    "docs:guidebook-docx": "pandoc docs/cms-guidebook.md -o docs/Jatayu-CMS-Guidebook.docx --resource-path=docs --toc --toc-depth=3 --metadata title=\"Jatayu CMS Guidebook\" --metadata author=\"Jatayu Healthcare Technologies\" --metadata date=\"May 2026\""
  },
  "dependencies": {
    "@firebasegen/default-connector": "file:dataconnect-generated/js/default-connector",
    "@payloadcms/db-postgres": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/storage-azure": "3.84.1",
    "@payloadcms/storage-gcs": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "graphql": "^16.13.2",
    "next": "^16.2.4",
    "otplib": "^13.4.1",
    "payload": "3.84.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
